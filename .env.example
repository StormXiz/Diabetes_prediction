# Copia este archivo a ".env" (misma carpeta) y rellena los valores reales.
# Nunca commitees el ".env" real — este .env.example no tiene secretos.

# --- Backend (FastAPI) ---
# Sin login: /predict/* es público, no necesita variables de Supabase.
# En local: http://localhost:3000 (valor por defecto, usado por docker-compose.yml).
# En producción (Railway): https://diabetesrisk.shop — ver RAILWAY.md.
FRONTEND_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
# Solo para leer contenido público (dietas, tabla de alimentos) — ya no hay
# login/registro, así que esto no maneja sesiones ni cuentas.
NEXT_PUBLIC_SUPABASE_URL=https://swgqlrbztvqikkyitqtx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Chatbot (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
